#!/bin/sh
set -eu

: "${ARIA_TAILSCALE_HOME:=/var/lib/aria-tailscale}"
export HOME="${HOME:-$ARIA_TAILSCALE_HOME}"

: "${ARIA_TAILSCALE_LISTEN:=:8787}"
: "${ARIA_TAILSCALE_TAILSCALE:=funnel}"
: "${ARIA_TAILSCALE_HOSTNAME:=ariacompute-funnel}"
: "${ARIA_TAILSCALE_STATE_DIR:=${ARIA_TAILSCALE_HOME}/tsnet}"

mkdir -p "$ARIA_TAILSCALE_HOME" "$ARIA_TAILSCALE_STATE_DIR"

ARGS=""
ARGS="$ARGS --listen $ARIA_TAILSCALE_LISTEN"
ARGS="$ARGS --tailscale $ARIA_TAILSCALE_TAILSCALE"
ARGS="$ARGS --hostname $ARIA_TAILSCALE_HOSTNAME"
ARGS="$ARGS --state-dir $ARIA_TAILSCALE_STATE_DIR"

# Default config location if ARIA_TAILSCALE_CONFIG is not set.
if [ -z "${ARIA_TAILSCALE_CONFIG:-}" ] && [ -f /etc/aria-tailscale/config.yaml ]; then
  ARIA_TAILSCALE_CONFIG=/etc/aria-tailscale/config.yaml
fi

if [ -n "${ARIA_TAILSCALE_CONFIG:-}" ]; then
  ARGS="$ARGS --config $ARIA_TAILSCALE_CONFIG"
fi

# Parse space-separated routes into repeated --route flags.
if [ -n "${ARIA_TAILSCALE_ROUTES:-}" ]; then
  for r in $ARIA_TAILSCALE_ROUTES; do
    ARGS="$ARGS --route $r"
  done
fi

# Resolve the Tailscale auth key WITHOUT ever passing it on the command line
# (avoids `ps` / /proc exposure). Precedence:
#   TS_AUTHKEY (env, e.g. from /etc/default/aria-tailscale)
#   > TS_AUTHKEY_FILE (0600 file)
#   > systemd LoadCredential ($CREDENTIALS_DIRECTORY/ts_authkey)
if [ -z "${TS_AUTHKEY:-}" ] && [ -n "${TS_AUTHKEY_FILE:-}" ] && [ -f "${TS_AUTHKEY_FILE}" ]; then
  TS_AUTHKEY="$(cat "${TS_AUTHKEY_FILE}")"
fi
if [ -z "${TS_AUTHKEY:-}" ] && [ -n "${CREDENTIALS_DIRECTORY:-}" ] && [ -f "${CREDENTIALS_DIRECTORY}/ts_authkey" ]; then
  TS_AUTHKEY="$(cat "${CREDENTIALS_DIRECTORY}/ts_authkey")"
fi
export TS_AUTHKEY

exec /usr/bin/aria-tailscale run $ARGS
