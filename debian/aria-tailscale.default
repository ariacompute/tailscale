# /etc/default/aria-tailscale
# Override these values, then run: sudo systemctl restart aria-tailscale

ARIA_TAILSCALE_HOME=/var/lib/aria-tailscale
ARIA_TAILSCALE_LISTEN=:8787
ARIA_TAILSCALE_TAILSCALE=funnel
ARIA_TAILSCALE_HOSTNAME=ariacompute-funnel
ARIA_TAILSCALE_STATE_DIR=/var/lib/aria-tailscale/tsnet

# Optional Tailscale auth key (required for funnel/tailnet).
# TS_AUTHKEY=

# Explicit config file (routes + settings). The Debian package installs a
# working template at /etc/aria-tailscale/config.yaml and loads it by default;
# edit that file to set your routes, or point this at another path.
ARIA_TAILSCALE_CONFIG=/etc/aria-tailscale/config.yaml

# Optional routes (host=upstream), space-separated. Override YAML routes.
# ARIA_TAILSCALE_ROUTES="app.example.com=http://127.0.0.1:8080 api.example.com=http://127.0.0.1:9090"
