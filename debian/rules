#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export CGO_ENABLED = 0

%:
	dh $@

override_dh_auto_build:
	mkdir -p build
	go build -trimpath -buildvcs=false -ldflags "-s -w" -o build/aria-tailscale ./cmd/aria-tailscale

override_dh_auto_test:
	go test ./...

override_dh_auto_clean:
	rm -rf build

# Keep the env defaults file root-only: if an operator writes TS_AUTHKEY there
# it must not be world-readable (Tier 1 hardening).
override_dh_fixperms:
	dh_fixperms
	chmod 600 debian/aria-tailscale/etc/default/aria-tailscale
