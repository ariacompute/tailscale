[Unit]
Description=Tailscale Funnel reverse proxy for ariacompute
Documentation=https://ariacompute.com
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=HOME=/var/lib/aria-tailscale
EnvironmentFile=-/etc/default/aria-tailscale
# Feed the Tailscale auth key from a 0600 file via a tmpfs credential (Tier 3).
# The file is created empty by the postinst; the operator fills it. Optionally
# replace with SetCredentialEncrypted=ts_authkey:... for at-rest encryption.
LoadCredential=ts_authkey:/etc/aria-tailscale/ts_authkey
WorkingDirectory=/var/lib/aria-tailscale
StateDirectory=aria-tailscale
ExecStart=/usr/lib/aria-tailscale/aria-tailscale-service
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/aria-tailscale

[Install]
WantedBy=multi-user.target
